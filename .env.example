# Optional public TestFlight join URL. When unset, the TestFlight button stays disabled.
NEXT_PUBLIC_TESTFLIGHT_URL=

# Formspree-style HTTPS endpoint. Server-only. Set in Vercel preview/prod — do not commit secrets.
WAITLIST_FORM_URL=

# Optional local JSONL path for `npm run dev` (default: .data/waitlist.jsonl). Do not use in production.
WAITLIST_LOCAL_PATH=
