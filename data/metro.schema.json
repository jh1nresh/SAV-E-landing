{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sav-e.app/schema/metro.json",
  "title": "Savvy metro sample data (source)",
  "type": "object",
  "required": ["_meta", "stations", "stores"],
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["example", "asOf"],
      "properties": {
        "example": { "type": "boolean" },
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "name", "line", "status", "updatedAt", "mapPos"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "line": { "type": "string", "minLength": 1 },
          "status": { "enum": ["live", "coming_soon"] },
          "updatedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "mapPos": {
            "type": "object",
            "required": ["line", "at"],
            "additionalProperties": false,
            "properties": {
              "line": { "enum": ["L_red", "L_blue", "L_green"] },
              "at": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stationId",
          "name",
          "dish",
          "priceNT",
          "priceFrom",
          "priceSource",
          "priceCheckedAt",
          "exit",
          "exitWalkMin",
          "area",
          "hours",
          "image",
          "sourcePosts",
          "addedAt",
          "verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stationId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "dish": { "type": "string", "minLength": 1 },
          "priceNT": { "type": "number", "minimum": 0 },
          "priceFrom": { "type": "boolean" },
          "priceSource": { "type": "string" },
          "priceCheckedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "exit": { "type": ["string", "null"] },
          "exitWalkMin": { "type": "number", "minimum": 0 },
          "area": { "type": "string" },
          "hours": { "type": "string" },
          "image": { "type": "string" },
          "sourcePosts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["platform", "url", "date"],
              "additionalProperties": false,
              "properties": {
                "platform": { "enum": ["ig", "threads", "xhs"] },
                "url": { "type": "string", "minLength": 1 },
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "addedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "verified": { "type": "boolean" }
        }
      }
    }
  }
}
