{
  "name": "sav-e-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-metro.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-metro.mjs && node scripts/make-og.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test": "npm run test:unit && playwright test",
    "check": "node scripts/build-metro.mjs && node scripts/check-forbidden.mjs && node scripts/check-glyphs.mjs && node scripts/check-output.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "pretypecheck": "node scripts/build-metro.mjs",
    "pretest": "node scripts/build-metro.mjs",
    "prelint": "node scripts/build-metro.mjs"
  },
  "dependencies": {
    "framer-motion": "latest",
    "lucide-react": "latest",
    "next": "16.4.3",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "latest"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
